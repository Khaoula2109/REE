# Server Configuration
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ree_meter_reading
DB_USER=root
DB_PASSWORD=

# JWT Configuration
JWT_SECRET=ree-super-secret-jwt-key-change-in-production-2024
JWT_EXPIRES_IN=30m
JWT_REFRESH_SECRET=ree-super-secret-refresh-key-change-in-production-2024
JWT_REFRESH_EXPIRES_IN=7d

# Email Configuration (Mailcatcher for development)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ree.ma
SMTP_FROM_NAME=REE - Rabat Energie & Eau

# Session Configuration (10 minutes = 600000 ms)
SESSION_TIMEOUT=600000

# SSL Configuration
SSL_KEY_PATH=./ssl/server.key
SSL_CERT_PATH=./ssl/server.crt

# CORS Configuration
CORS_ORIGIN=http://localhost:5173
