# REE Application Environment Variables
# Copy this file to .env and update with your values

# Application
NODE_ENV=development

# Database Configuration
MYSQL_ROOT_PASSWORD=root_password_change_me
DB_NAME=ree_meter_reading
DB_USER=ree_user
DB_PASSWORD=ree_password_change_me
DB_HOST=mysql
DB_PORT=3306

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-production
JWT_REFRESH_SECRET=your-super-secret-refresh-key-min-32-chars-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# API Configuration
PORT=5001
API_PREFIX=/api
CORS_ORIGIN=http://localhost:81

# Frontend Configuration
VITE_API_URL=http://localhost:5001/api
VITE_APP_NAME=REE

# Ports
BACKEND_PORT=5001
FRONTEND_PORT=81
MYSQL_PORT=3307
REDIS_PORT=6380
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
NGINX_HTTP_PORT=8080
NGINX_HTTPS_PORT=8443

# Monitoring
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Email Configuration (optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@ree.ma

# Logging
LOG_LEVEL=info
